# Copia este archivo a ".env" para desarrollo local (con `vercel dev`) y
# define las mismas variables en Vercel -> Project Settings -> Environment
# Variables antes de desplegar.

# --- Backend (funciones /api, usan la Service Role Key: NUNCA exponerla al
#     navegador ni ponerle el prefijo VITE_) ------------------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Project Settings -> API -> service_role
ADMIN_PASSWORD=una-contraseña-fuerte-para-el-admin
JWT_SECRET=genera-una-cadena-larga-y-aleatoria   # p.ej: openssl rand -hex 32

# --- Frontend (Vite las mete en el bundle del navegador: usa SIEMPRE la
#     clave "anon/public", nunca la service_role) -------------------------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # Project Settings -> API -> anon public
